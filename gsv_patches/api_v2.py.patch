+# —— 让「整句合成」走自己的一条 CUDA 流 ——
+# 一个进程里所有推理默认都排在同一条 CUDA 流上：只要有一条整句合成在跑，
+# 正在说出口的流式请求就被整段饿死（实测停 5 秒）。给整句合成单独一条流，
+# 两边就能在 GPU 上交错推进，不用再让整句合成排队等流式念完。
+_CUDA_STREAMS: list = []
+_STREAM_TURN = [0]
+_STREAM_LOCK = threading.Lock()
+
+
+def _pick_cuda_stream():
+    try:
+        import torch
+
+        if not torch.cuda.is_available():
+            return None
+        with _STREAM_LOCK:
+            if not _CUDA_STREAMS:
+                torch.cuda.synchronize()          # 模型权重在主流程上，先对齐
+                _CUDA_STREAMS.extend(torch.cuda.Stream() for _ in range(4))
+            _STREAM_TURN[0] = (_STREAM_TURN[0] + 1) % len(_CUDA_STREAMS)
+            return _CUDA_STREAMS[_STREAM_TURN[0]]
+    except Exception as exc:  # noqa: BLE001
+        print(f"[stream] 拿不到 CUDA 流，退回默认流：{exc}")
+        return None
+
 
