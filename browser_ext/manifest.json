{
  "manifest_version": 3,
  "name": "泡泡桌宠 · 播放进度上报",
  "version": "1.0.0",
  "description": "把当前网页视频的播放进度发给本机网关（127.0.0.1:9888），让桌面上的泡泡知道你看到哪一段了。只读进度，不碰页面内容。",
  "permissions": ["tabs"],
  "host_permissions": ["http://127.0.0.1:9888/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.bilibili.com/*",
        "*://*.youtube.com/*",
        "*://*.iqiyi.com/*",
        "*://*.youku.com/*",
        "*://*.mgtv.com/*",
        "*://v.qq.com/*",
        "*://*.douyin.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
