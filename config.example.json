{
    "listen_host": "127.0.0.1",
    "listen_port": 9888,
    "upstream_base_url": "https://api.deepseek.com",
    "upstream_chat_path": "/v1/chat/completions",
    "api_key": "",
    "upstream_timeout": 300,
    "tts": {
        "enabled": true,
        "backend": "gpt-sovits",
        "api": "http://127.0.0.1:9882",
        "api_stream": "http://127.0.0.1:9882",
        "api_file": "",
        "ref_audio_path": "C:\\path\\to\\your\\ref.wav",
        "prompt_text": "参考音频里说的那句原话",
        "prompt_lang": "zh",
        "text_lang": "zh",
        "max_sentences": 40,
        "max_chars_per_sentence": 32,
        "first_min_chars": 24,
        "second_min_chars": 5,
        "early_sentences": 3,
        "early_min_chars": 8,
        "timeout": 180,
        "volume": 1.2,
        "synth_workers": 3,
        "pre_cue": [
            "让我看看……",
            "唔，我瞅瞅。"
        ],
        "pre_cue_min_interval": 20,
        "retention_days": 3,
        "speed": 1.2,
        "speed_first": 1.0,
        "cache_pre_cue": true,
        "streaming_first": true,
        "streaming_mode": 3,
        "stream_min_chunk_length": 32,
        "stream_min_chunk_length_first": 16,
        "stream_overlap_length": 2,
        "stream_merge_chars": 40,
        "stream_gpu_wait": 25,
        "strip_stream_punct_max_chars": 24,
        "prebuffer_seconds": 0.5,
        "prebuffer_first_seconds": 0.45,
        "exclusive_gpu": false,
        "strip_stream_punct": true,
        "stream_split_method": "cut0",
        "max_internal_pause": 0,
        "output_device": "",
        "synth_parallel": 2,
        "tight_sentence_edges": true,
        "sentence_head_pad": 0.03,
        "sentence_tail_pad": 0.08,
        "reading_fixes": {}
    },
    "speak_chat": true,
    "speak_vision": true,
    "inject_vision_ledger": true,
    "wipe_owner_word": true,
    "memory_inbox_url": "",
    "memory_inbox_scenarios": [
        "vision"
    ],
    "dsh": {
        "enabled": true,
        "event_dir": "",
        "speak_tools": false,
        "tool_min_interval": 25,
        "poll_seconds": 1.5
    },
    "ledger_path": "ledger.jsonl",
    "log_path": "logs/gateway.log",
    "inject_recent_minutes": 45,
    "inject_recent_entries": 3,
    "ledger_digest": {
        "enabled": true,
        "interval_hours": 3,
        "min_entries": 8,
        "max_entries": 300,
        "max_chars": 240,
        "retention_hours": 24
    },
    "frame_buffer": {
        "enabled": true,
        "interval_seconds": 1.5,
        "keep": 5,
        "frame_width": 640,
        "jpeg_quality": 82,
        "grid_frames": 4,
        "attach_to_vision": true
    },
    "bubble": {
        "enabled": true,
        "duration_ms": 3200,
        "max_chars": 60
    },
    "voice": {
        "enabled": true,
        "mode": "ptt",
        "hotkey": "ctrl+alt+v",
        "vad_silence": 1.2,
        "max_record": 30,
        "min_record": 0.3,
        "energy_threshold": 0.012,
        "no_speech_timeout": 3.0,
        "call_window": 8,
        "barge_in": false,
        "asr_url": "http://127.0.0.1:9881/v1/audio/transcriptions"
    },
    "video_watch": {
        "enabled": true,
        "poll_seconds": 2.0,
        "enter_min_seconds": 120,
        "audio_threshold": 0.004,
        "audio_active_seconds": 30,
        "input_idle_seconds": 60,
        "input_events_window": 180,
        "input_events_max": 15,
        "away_grace_seconds": 300,
        "paused_grace_seconds": 600,
        "paused_away_grace_seconds": 120,
        "asr_chunk_seconds": 10,
        "asr_url": "http://127.0.0.1:9881/v1/audio/transcriptions",
        "asr_min_cjk_ratio": 0.25,
        "ocr_interval_seconds": 2.0,
        "ocr_python": "C:\\path\\to\\ocrvenv\\Scripts\\python.exe",
        "ocr_bottom_ratio": 0.34,
        "transcript_keep": 12,
        "speak_hint": true,
        "loopback_device": ""
    },
    "soften_self_recognition": true,
    "self_recognition": {
        "cooldown_minutes": 90,
        "lookback_minutes": 90
    },
    "vision_context_minutes": 180,
    "vision_context_entries": 6,
    "vision_context_budget_chars": 600,
    "vision_context_item_chars": 90,
    "divination_voice": {
        "enabled": true,
        "max_line_age_seconds": 90,
        "dedupe_minutes": 60
    },
    "look_guard": {
        "enabled": true,
        "idle_minutes": 5,
        "check_seconds": 30,
        "helper_port": 9893
    },
    "vision_fresh_minutes": 10,
    "vision_mention_minutes": 30,
    "mute_vision_when_off": false,
    "watch_focus": true,
    "see_howto": true,
    "title_learner": {
        "enabled": true,
        "interval_seconds": 60,
        "min_checks": 2,
        "cooldown_minutes": 360
    }
}